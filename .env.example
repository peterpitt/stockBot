# ══════════════════════════════════════════════════════
#  台股當沖系統 — 環境變數範本
#  複製此檔為 .env 並填入真實數值，永遠不要 commit .env
# ══════════════════════════════════════════════════════

# ── Shioaji 永豐金證券 API ────────────────────────────
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here
SHIOAJI_ACCOUNT_ID=your_account_id        # 帳號 (如: F123456789)
SHIOAJI_CA_PATH=./certs/Sinopac.pfx       # 憑證路徑
SHIOAJI_CA_PASSWD=your_ca_password

# ── 交易環境 ─────────────────────────────────────────
TRADING_ENV=simulation                    # simulation | production
MAX_POSITION_PER_STOCK=100000             # 單檔最大部位（元）
MAX_TOTAL_EXPOSURE=500000                 # 總部位上限（元）
STOP_LOSS_PCT=0.02                        # 停損百分比 2%
FORCE_CLOSE_TIME=13:25                    # 強制平倉時間

# ── 資料庫 ───────────────────────────────────────────
DB_TYPE=sqlite                            # sqlite | supabase
SQLITE_PATH=./data/processed/trades.db
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ── 選股參數 ─────────────────────────────────────────
TRUST_BUY_CONSECUTIVE_DAYS=3              # 投信連續買超天數門檻
TRUST_BUY_RATIO_PCT=0.005                 # 投信買超佔股本比例門檻 (0.5%)
BRANCH_BUY_THRESHOLD=500                  # 分點買超張數門檻

# ── 日誌 ─────────────────────────────────────────────
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
LOG_DIR=./logs
